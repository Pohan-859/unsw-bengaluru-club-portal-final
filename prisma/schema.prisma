// UNSW Bengaluru Club Management Portal — database schema
// Configured for local SQLite / zero-config setup

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String             @id @default(cuid())
  name          String?
  email         String             @unique
  image         String?
  role          String             @default("STUDENT") // STUDENT | ADMIN
  studentId     String?
  degree        String?
  createdAt     DateTime           @default(now())
  memberships   Membership[]
  registrations ClubRegistration[]

  @@map("users")
}

model Club {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  category    String
  tagline     String?
  description String
  logoUrl     String?
  coverUrl    String?
  execName    String?
  execEmail   String?
  execPhone   String? // only ever shown to APPROVED members — see /api/clubs/[slug]
  meetingInfo String?
  instagram   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships Membership[]

  @@index([category])
  @@map("clubs")
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  clubId    String
  role      String   @default("MEMBER") // MEMBER | EXECUTIVE
  status    String   @default("PENDING") // PENDING | APPROVED | REJECTED
  message   String?  // why the student wants to join / their pitch for an EXECUTIVE role
  feedback  String?  // admin/club exec note, shown to the student on reject
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([userId, clubId]) // one active application per student per club
  @@index([status])
  @@map("memberships")
}

model ClubRegistration {
  id          String   @id @default(cuid())
  proposedBy  String
  name        String
  category    String
  description String
  meetingPlan String?  // proposed meeting cadence / first event
  status      String   @default("PENDING") // PENDING | APPROVED | REJECTED
  feedback    String?  // admin explanation shown to the proposer
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [proposedBy], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("club_registrations")
}
