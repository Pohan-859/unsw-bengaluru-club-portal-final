// UNSW Bengaluru Club Management Portal — database schema
// Provider: Supabase Postgres. DIRECT_URL is used for migrations so they
// bypass Supabase's connection pooler.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  ADMIN
}

enum MembershipRole {
  MEMBER
  EXECUTIVE
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String             @id @default(cuid())
  name          String?
  email         String             @unique
  image         String?
  role          Role               @default(STUDENT)
  studentId     String?
  degree        String?
  createdAt     DateTime           @default(now())
  memberships   Membership[]
  registrations ClubRegistration[]

  @@map("users")
}

model Club {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  category    String
  tagline     String?
  description String
  logoUrl     String?
  coverUrl    String?
  execName    String?
  execEmail   String?
  execPhone   String? // only ever shown to APPROVED members — see /api/clubs/[slug]
  meetingInfo String?
  instagram   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships Membership[]

  @@index([category])
  @@map("clubs")
}

model Membership {
  id        String            @id @default(cuid())
  userId    String
  clubId    String
  role      MembershipRole    @default(MEMBER)
  status    ApplicationStatus @default(PENDING)
  message   String?           // why the student wants to join / their pitch for an EXECUTIVE role
  feedback  String?           // admin/club exec note, shown to the student on reject
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([userId, clubId]) // one active application per student per club
  @@index([status])
  @@map("memberships")
}

model ClubRegistration {
  id          String            @id @default(cuid())
  proposedBy  String
  name        String
  category    String
  description String
  meetingPlan String?           // proposed meeting cadence / first event
  status      ApplicationStatus @default(PENDING)
  feedback    String?           // admin explanation shown to the proposer
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user User @relation(fields: [proposedBy], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("club_registrations")
}
