// UNSW Bengaluru Club Management Portal — database schema
// Provider: Supabase Postgres. DIRECT_URL is used for migrations so they
// bypass Supabase's connection pooler.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  ADMIN
}

enum MembershipRole {
  MEMBER
  EXECUTIVE
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RSVPStatus {
  GOING
  MAYBE
  NOT_GOING
}

model User {
  id              String             @id @default(cuid())
  name            String?
  email           String             @unique
  image           String?
  role            Role               @default(STUDENT)
  studentId       String?
  degree          String?
  bio             String?
  major           String?
  gradYear        Int?
  isProfilePublic Boolean            @default(true)
  createdAt       DateTime           @default(now())
  memberships     Membership[]
  registrations   ClubRegistration[]
  rsvps           RSVP[]
  announcements   Announcement[]

  @@map("users")
}

model Club {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  category    String
  tagline     String?
  description String
  logoUrl     String?
  coverUrl    String?
  execName    String?
  execEmail   String?
  execPhone   String? // only ever shown to APPROVED members — see /api/clubs/[slug]
  meetingInfo String?
  instagram   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships    Membership[]
  events         Event[]
  announcements  Announcement[]

  @@index([category])
  @@map("clubs")
}

model Membership {
  id        String            @id @default(cuid())
  userId    String
  clubId    String
  role        MembershipRole    @default(MEMBER)
  customTitle String?
  status    ApplicationStatus @default(PENDING)
  message   String?           // why the student wants to join / their pitch for an EXECUTIVE role
  feedback  String?           // admin/club exec note, shown to the student on reject
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([userId, clubId]) // one active application per student per club
  @@index([status])
  @@map("memberships")
}

model ClubRegistration {
  id          String            @id @default(cuid())
  proposedBy  String
  name        String
  category    String
  description String
  meetingPlan String?           // proposed meeting cadence / first event
  status      ApplicationStatus @default(PENDING)
  feedback    String?           // admin explanation shown to the proposer
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user User @relation(fields: [proposedBy], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("club_registrations")
}

model Event {
  id          String     @id @default(cuid())
  clubId      String
  title       String
  description String
  location    String?
  startTime   DateTime
  endTime     DateTime?
  capacity    Int?       // null = unlimited
  coverUrl    String?
  checkInPin  String?    // 6-digit PIN for attendance check-in
  isPublic    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  club  Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  rsvps RSVP[]

  @@index([clubId])
  @@index([startTime])
  @@map("events")
}

model RSVP {
  id        String     @id @default(cuid())
  eventId   String
  userId    String
  status    RSVPStatus @default(GOING)
  checkedIn Boolean    @default(false)
  createdAt DateTime   @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@map("rsvps")
}

model Announcement {
  id        String   @id @default(cuid())
  clubId    String
  authorId  String
  title     String
  content   String
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  club   Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@index([clubId])
  @@index([createdAt])
  @@map("announcements")
}
